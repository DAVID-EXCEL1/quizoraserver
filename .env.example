# ---- Core ----
NODE_ENV=development
PORT=4000
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quizora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quizora
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Extra allowed browser origins (comma separated). Defaults to CLIENT_URL.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Number of reverse proxies in front of the API (1 on Render/Fly/Heroku/nginx) so rate limits see real client IPs.
TRUST_PROXY=0

# ---- Auth (REQUIRED in production: random string, 32+ chars; e.g. `openssl rand -base64 48`) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Cookie settings. Prefer same-site hosting (app.example.com + api.example.com) with lax.
# Use COOKIE_SAMESITE=none ONLY if the SPA and API are on different sites (forces Secure cookies).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
BCRYPT_ROUNDS=12
REFRESH_TTL_DAYS=14

# ---- Email (verification + password recovery). Leave blank to disable; the app then says so honestly. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Quizora <no-reply@example.com>
# Development only: print emailed links to the server console instead of needing SMTP. Ignored in production.
DEV_LOG_EMAIL_LINKS=false

# ---- Image uploads (optional) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Game tuning (all optional) ----
ROOM_INACTIVITY_MINUTES=120
ROOM_RETENTION_DAYS=7
MAX_PLAYERS_PER_ROOM=200
ENABLE_WORKER=true

# ---- Scaling (optional) ----
# REDIS_URL=redis://localhost:6379   (also: npm i @socket.io/redis-adapter redis)
