# ---- Core ----
NODE_ENV=development
PORT=4000
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quizora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quizora
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Extra allowed browser origins (comma separated). Defaults to CLIENT_URL.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Number of reverse proxies in front of the API (1 on Render/Fly/Heroku/nginx) so rate limits see real client IPs.
TRUST_PROXY=0

# ---- Auth (REQUIRED in production: random string, 32+ chars; e.g. `openssl rand -base64 48`) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Cookie settings. Prefer same-site hosting (app.example.com + api.example.com) with lax.
# Use COOKIE_SAMESITE=none ONLY if the SPA and API are on different sites (forces Secure cookies).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
BCRYPT_ROUNDS=12
REFRESH_TTL_DAYS=14

# ---- Email (verification + password recovery). Resend requires an API key and a verified sender domain. ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Development only: print emailed links to the server console instead of needing Resend. Ignored in production.
DEV_LOG_EMAIL_LINKS=false

# ---- Image uploads (optional) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Game tuning (all optional) ----
ROOM_INACTIVITY_MINUTES=120
ROOM_RETENTION_DAYS=7
MAX_PLAYERS_PER_ROOM=200
ENABLE_WORKER=true

# ---- Scaling (optional) ----
# REDIS_URL=redis://localhost:6379   (also: npm i @socket.io/redis-adapter redis)

# ---- Payments (Paystack) ----
# Dashboard -> Settings -> API Keys. Use sk_test_... while testing.
PAYSTACK_SECRET_KEY=
# In Paystack Settings -> API Keys & Webhooks, set the Webhook URL to:  https://YOUR-API-HOST/api/webhooks/paystack
# (and the Callback URL is sent automatically as CLIENT_URL/billing/callback)

# ---- AI question generator (Groq) + photos (Pexels) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PEXELS_API_KEY=
# Optional overrides, e.g. to route through a proxy or a local stand-in for testing:
# GROQ_BASE_URL=https://api.groq.com   PEXELS_BASE_URL=https://api.pexels.com   PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Limits ----
# Hard ceiling for "players per game" that any plan or override can set.
MAX_PLAYERS_CEILING=1000
